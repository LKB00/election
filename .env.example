# Leave DATABASE_URL empty to use a local file database (.data/). 
# In production set it to a Postgres URL (Neon, Supabase, etc).
DATABASE_URL=
# Long random text. Used to sign the voter cookie.
VOTER_SECRET=change-me

# Optional. Each feature stays off until its setting is filled in.
# The owner's review page: open /admin?key=<this>. 16+ characters.
ADMIN_SECRET=
# Complaints contact shown on the Privacy page (IT Rules).
NEXT_PUBLIC_GRIEVANCE_NAME=
NEXT_PUBLIC_GRIEVANCE_EMAIL=
# Phone alert for each report: an ntfy.sh topic URL (install the free ntfy app, subscribe to the same secret topic).
REPORT_ALERT_URL=
# Vote-rate limits shared by all servers (free account at upstash.com).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Invisible "are you a person?" check on votes (free, Cloudflare Turnstile).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Election silence windows: politics duels hide results during these (India time shown here).
# SILENCE_WINDOWS=[{"from":"2027-02-08T18:00:00+05:30","to":"2027-03-10T18:00:00+05:30"}]

# "Tell me the result" phone alerts (web push). Make a key pair once: npx web-push generate-vapid-keys
# The public key is safe to show; keep the private key secret. Without them the button does not appear.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Vercel sends this to /api/cron/results each evening (9:05 pm India time) to send the alerts for polls that ended.
CRON_SECRET=

# Google and phone-number sign-in (optional; off when empty). From Firebase: Project settings → General → Your apps →
# Web app → the config values. See docs/OWNER_TODO.md for the steps. These three are public by design.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# Phone-number sign-in costs money per SMS (Firebase Blaze plan). Set to "on" only after upgrading.
NEXT_PUBLIC_FIREBASE_PHONE=
